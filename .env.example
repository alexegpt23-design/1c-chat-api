ONEC_URL=https://1cfresh.com/a/ea/BASE_ID/odata/standard.odata/
ONEC_USER=odata-user
ONEC_PASSWORD=replace-me
PORT=3001
HOST=127.0.0.1
# Случайный секрет для X-API-Key. Без него сервер не запускается.
API_KEY=replace-with-random-secret
PUBLIC_BASE_URL=https://api.scheta.online
# Необязательно: отдельный секрет подписанных PDF-ссылок (иначе API_KEY).
# PDF_SIGNING_KEY=
ONEC_TIMEOUT_MS=30000
ONEC_TIMEZONE=Europe/Moscow
ONEC_USE_PROXY=false
# Необязательные значения. Организация и валюта берутся из договора.
# ONEC_ORGANIZATION_REF=
# ONEC_CURRENCY_REF=
# ONEC_WAREHOUSE_REF=
# ONEC_RESPONSIBLE_REF=
# ONEC_BANK_ACCOUNT_REF=
# ONEC_VAT_RATE=22

# Гибридный поиск номенклатуры через локальный worker.
PRODUCT_SEARCH_MODE=hybrid
PRODUCT_SEARCH_WORKER_URL=http://127.0.0.1:3199
PRODUCT_SEARCH_WORKER_TIMEOUT_MS=2000
PRODUCT_SEARCH_WORKER_HOST=127.0.0.1
PRODUCT_SEARCH_WORKER_PORT=3199
PRODUCT_EMBEDDING_LOCAL_ONLY=true
